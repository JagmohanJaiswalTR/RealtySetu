# ---------------------------------------------------------------
# Project-Ecomm — local development environment
# Copy to .env and fill in. NEVER commit a real .env.
# In staging/prod these come from AWS SSM Parameter Store / Secrets Manager.
# ---------------------------------------------------------------

NODE_ENV=development

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql://ecomm:ecomm_dev_pw@localhost:5432/ecomm?schema=public
# Read replica (optional). Public read-heavy queries go here when set.
DATABASE_READ_URL=

# --- Redis (cache, rate-limit store, BullMQ) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=30d

# --- Web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Object storage (S3; MinIO locally) ---
S3_REGION=ap-south-1
S3_BUCKET_MEDIA=ecomm-media-dev
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/ecomm-media-dev

# --- AI service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-internal-token

# --- Meta (WhatsApp Cloud API / Instagram Graph API / Lead Ads) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Google Ads lead form webhook ---
GOOGLE_ADS_WEBHOOK_KEY=

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Project-Ecomm <no-reply@example.com>"
